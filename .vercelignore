# Training data stays out of the deployment (the function only runs inference
# with the committed models in checkpoints/). The small IMU validation split is
# kept so /api/v1/telemetry/imu can serve real sample windows.
datasets/**
!datasets/04_mobile_imu_telemetry_100hz/
!datasets/04_mobile_imu_telemetry_100hz/imu_metadata.json
!datasets/04_mobile_imu_telemetry_100hz/imu_shock_100hz_val.npz
datasets/04_mobile_imu_telemetry_100hz/imu_shock_100hz_train.npz
datasets/04_mobile_imu_telemetry_100hz/imu_telemetry_sample.csv

# Exclude offline training, test suites, scripts, virtualenvs, and scratch
training/**
tests/**
scripts/**
scratch/**
.venv/**

# Exclude heavy ONNX backbones (inference falls back cleanly to scikit-learn + OpenCV)
*.onnx
checkpoints/*.onnx

# Exclude documents, presentations, videos, and batch files
*.bat
*.pptx
*.pdf
*.log
*.tmp
*.mp4
*.avi
*.mov
*.zip

legacy_dashboard.html

