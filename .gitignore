# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.env
.venv
venv/
env/

# Large binary/data files (keep NPZ checkpoints but exclude huge JSON spec)
checkpoints/road_shield_open_neural_spec.json
# ResNet-50 is 98 MB - over GitHub's per-file limit and pointless in version
# control. Fetch it with:  python -m scripts.fetch_cnn_backbone
checkpoints/cnn_backbone_resnet50.onnx
*.mp4
*.avi
*.mov

# Logs
*.log
logs/tunnel_*
logs/engine_public_*
logs/go_live_pids.txt
daemon_server.log
server_stdout.log
server_stderr.log

# Temp/scratch
test_write.txt
test_syntax.js
find_routes.py
scratch/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

datasets/*.zip
datasets/ivcnz_potholes.zip
.vercel

# Runtime logs written by the API server
checkpoints/active_feedback_log.jsonl

# Raw dataset downloads and intermediate crops (scripts/fetch_datasets.py).
# Promoted training images under datasets/<class>/real_images stay tracked.
datasets/incoming/
datasets/patches/
# Crops pulled by scripts/fetch_cracks_potholes_dataset.py - regenerate with
# that script rather than committing ~110 MB of derived images.
datasets/*/real_images/cpr_*.jpg

# Google Maps API key file - never commit a key
checkpoints/google_maps_api_key.txt

# Runtime database - regenerated, machine-specific
checkpoints/road_shield.db
checkpoints/road_shield.db-wal
checkpoints/road_shield.db-shm

# Local data and run outputs - large, re-downloadable, or personal (licence
# plates are personal data and must not be published)
datasets/_downloads/
datasets/CDSet/
datasets/crosswalk/
datasets/license_plates/
datasets/rdd2022_india/
runs/
yolo11n.pt
.env*.local

# never commit secrets or Vercel's local link
.env
.env*.local
*.pem
*.key
.vercel

# RDD2022 India crops (scripts/ingest_rdd2022_india.py) - regenerated from the local dataset
datasets/*/real_images/rddin_*.jpg
datasets/_eval_rdd2022_india/

# Local helper files and tooling that are not part of the project
node_modules/
docs/report/
docs/RUN_push_audit.bat
push_audit.bat
push_audit.ps1
push_update.ps1
audit_commit_msg.txt
runs/
road_shield_*outputs.zip
road_shield_imu_fix.zip
checkpoints/defect_segmenter_unet.pt
logs/tunnel.*
logs/engine_public.*

# MLOps: model versions, runs and MLflow mirror (large; every version of every model)
mlops_store/
mlruns/

# pixel-labelled segmentation sets (scripts/fetch_seg_datasets.py): images and raw clones stay local; manifest.json is tracked
datasets/seg_multi/*/
datasets/external/*/
!datasets/external/*/MANIFEST.json
checkpoints/segmenter_backup/
checkpoints/segformer_candidate/*.onnx
checkpoints/segformer_candidate/*.pt
