# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.env
.venv
venv/
env/

# Large binary/data files (keep NPZ checkpoints but exclude huge JSON spec)
checkpoints/road_shield_open_neural_spec.json
# ResNet-50 is 98 MB - over GitHub's per-file limit and pointless in version
# control. Fetch it with:  python -m scripts.fetch_cnn_backbone
checkpoints/cnn_backbone_resnet50.onnx
*.mp4
*.avi
*.mov

# Logs
*.log
daemon_server.log
server_stdout.log
server_stderr.log

# Temp/scratch
test_write.txt
test_syntax.js
find_routes.py
scratch/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

datasets/*.zip
datasets/ivcnz_potholes.zip
.vercel

# Runtime logs written by the API server
checkpoints/active_feedback_log.jsonl

# Raw dataset downloads and intermediate crops (scripts/fetch_datasets.py).
# Promoted training images under datasets/<class>/real_images stay tracked.
datasets/incoming/
datasets/patches/
# Crops pulled by scripts/fetch_cracks_potholes_dataset.py - regenerate with
# that script rather than committing ~110 MB of derived images.
datasets/*/real_images/cpr_*.jpg

# Google Maps API key file - never commit a key
checkpoints/google_maps_api_key.txt

# Runtime database - regenerated, machine-specific
checkpoints/road_shield.db
checkpoints/road_shield.db-wal
checkpoints/road_shield.db-shm
